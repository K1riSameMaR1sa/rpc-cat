# OS junk
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/
*.swp

# node (there are no runtime dependencies, but be safe)
node_modules/
npm-debug.log*

# Large memory files: import these through the app instead of committing them.
# The small demo subset in data/demo-tm.tmx IS committed on purpose.
rpc-tm/
*.tmx.bak
!data/demo-tm.tmx

# NOTE: rpc-cat.html is a build artifact (npm run build) but IS committed on
# purpose, so that anyone can clone and double-click it without a toolchain.
# The --with-master variant embeds the whole memory (4.5 MB) and is NOT committed.
rpc-cat-full.html

# Rendered by scripts/preview-brand.py to eyeball a change to the brand mark.
# The script is committed so the image can be reproduced; the image is not.
docs-preview/
